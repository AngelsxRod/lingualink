# URL del backend NestJS, usada server-side por next.config.ts (rewrites) para actuar
# como proxy same-origin — así el cookie httpOnly del login llega al proxy.ts del cliente.
API_URL=http://localhost:3000

# Debe coincidir con JWT_SECRET del backend: proxy.ts verifica el JWT de la cookie
# para decidir si redirige lejos de /auth/login y /auth/register.
JWT_SECRET=changeme
